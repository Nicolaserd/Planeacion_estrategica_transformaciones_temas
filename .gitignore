.env
.venv/
data/
cache/
# outputs/ se publica, salvo los Excel de clasificación originales (Nombre, Correo y comentario sin anonimizar):
# de ellos solo se sube la copia …_anonimizado.xlsx
outputs/**/Clasificacion_*.xlsx
!outputs/**/Clasificacion_*_anonimizado.xlsx
# Lo mismo en el flujo combinado BERTopic → Jev
flujo_bert_jev/**/Clasificacion_*.xlsx
!flujo_bert_jev/**/Clasificacion_*_anonimizado.xlsx
__pycache__/
.pytest_cache/
# Configuración personal de Claude Code (cada persona tiene la suya; la del proyecto es .claude/settings.json)
.claude/settings.local.json
# Encuestas originales de Forms (traen Nombre y Correo): nunca se suben, en ninguna carpeta
**/Experiencia*.xlsx
# Listas de asistencia y muestras de los encuentros (traen nombres, documentos y correos): nunca se suben
**/asistencia/
**/participacion-*.xlsx
**/Muestra por unidad regional*.xlsx
# Documento del Plan Estratégico: no se publica (decisión de Nicolás, 2026-10-02)
**/06. PLAN ESTRAT*
# Archivos temporales de Office (se crean al abrir un Word o Excel)
~$*

# Instrumento de valoración del encuentro (exportación de Microsoft Forms, respuestas abiertas)
flujo_bert_jev/informe/Valoracion encuentro/
