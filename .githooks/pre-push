#!/bin/sh
# Hook de git · pre-push
# Regla del proyecto (2026-10-02): todo lo que se sube tiene una sola autoría, la de quien hace el push.
# Bloquea el push si algún commit por subir es de otro autor (distinto de git config user.email)
# o trae coautores o atribución a herramientas en el mensaje.
# Activación (una vez por copia del repositorio): git config core.hooksPath .githooks

email=$(git config user.email | tr '[:upper:]' '[:lower:]')
fallo=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac          # se está borrando una rama remota
  case "$remote_sha" in
    *[!0]*) commits=$(git rev-list "$remote_sha..$local_sha") ;;
    *)      commits=$(git rev-list "$local_sha" --not --remotes) ;;  # rama nueva
  esac
  for sha in $commits; do
    corto=$(git log -1 --format=%h "$sha")
    autor=$(git log -1 --format=%ae "$sha" | tr '[:upper:]' '[:lower:]')
    if [ -n "$email" ] && [ "$autor" != "$email" ]; then
      echo "pre-push: el commit $corto es de $autor y quien hace el push es $email (regla de única autoría)." >&2
      fallo=1
    fi
    if git log -1 --format=%B "$sha" | grep -qiE 'co-authored-by[[:space:]]*:|noreply@anthropic\.com|generated with \[?claude'; then
      echo "pre-push: el commit $corto tiene coautoría o atribución a una herramienta en el mensaje." >&2
      fallo=1
    fi
  done
done
if [ "$fallo" -ne 0 ]; then
  echo "pre-push: push cancelado. Corrige los commits (git commit --amend o git rebase) y vuelve a intentarlo." >&2
fi
exit $fallo
